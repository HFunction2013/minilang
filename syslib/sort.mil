// sort.mil - sorting and searching for minilang
//
// Sorting happens in place and returns the same array, because arrays are
// shared by reference:
//
//   require sort;
//   var a = [5, 3, 9];
//   sort.ints(a);                  // a is now [3, 5, 9]
//   var names = ["bob", "ann"];
//   sort.strings(names);           // ["ann", "bob"]

// Quicksort for int arrays (in place, returns a)
func ints(a) {
    if (len(a) < 2) { return a; }
    qint(a, 0, len(a) - 1);
    return a;
}

func qint(a, lo, hi) {
    if (lo >= hi) { return 0; }
    var p = a[(lo + hi) / 2];
    var i = lo;
    var j = hi;
    while (i <= j) {
        while (a[i] < p) { i = i + 1; }
        while (a[j] > p) { j = j - 1; }
        if (i <= j) {
            var t = a[i];
            a[i] = a[j];
            a[j] = t;
            i = i + 1;
            j = j - 1;
        }
    }
    qint(a, lo, j);
    qint(a, i, hi);
    return 0;
}

// Descending order for int arrays (in place, returns a)
func intsDesc(a) {
    ints(a);
    var i = 0;
    var j = len(a) - 1;
    while (i < j) {
        var t = a[i];
        a[i] = a[j];
        a[j] = t;
        i = i + 1;
        j = j - 1;
    }
    return a;
}

// Quicksort for string arrays (lexicographic by strcmp, in place)
func strings(a) {
    if (len(a) < 2) { return a; }
    qstr(a, 0, len(a) - 1);
    return a;
}

func qstr(a, lo, hi) {
    if (lo >= hi) { return 0; }
    var p = a[(lo + hi) / 2];
    var i = lo;
    var j = hi;
    while (i <= j) {
        while (strcmp(a[i], p) < 0) { i = i + 1; }
        while (strcmp(a[j], p) > 0) { j = j - 1; }
        if (i <= j) {
            var t = a[i];
            a[i] = a[j];
            a[j] = t;
            i = i + 1;
            j = j - 1;
        }
    }
    qstr(a, lo, j);
    qstr(a, i, hi);
    return 0;
}

// Insertion sort: stable and fast on nearly sorted arrays (in place)
func insert(a) {
    var i = 1;
    var n = len(a);
    while (i < n) {
        var x = a[i];
        var j = i - 1;
        while (j >= 0) {
            if (a[j] > x) {
                a[j + 1] = a[j];
                j = j - 1;
            } else {
                break;
            }
        }
        a[j + 1] = x;
        i = i + 1;
    }
    return a;
}

// Binary search in a sorted int array; returns the index, or -1
func bsearch(a, x) {
    var lo = 0;
    var hi = len(a) - 1;
    while (lo <= hi) {
        var mid = (lo + hi) / 2;
        if (a[mid] == x) { return mid; }
        if (a[mid] < x) {
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    return -1;
}

// Binary search in a sorted string array; returns the index, or -1
func bsearchStr(a, x) {
    var lo = 0;
    var hi = len(a) - 1;
    while (lo <= hi) {
        var mid = (lo + hi) / 2;
        if (strcmp(a[mid], x) == 0) { return mid; }
        if (strcmp(a[mid], x) < 0) {
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    return -1;
}

// Is the int array already sorted ascending?
func isSorted(a) {
    var i = 1;
    while (i < len(a)) {
        if (a[i - 1] > a[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}
