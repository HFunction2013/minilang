// io.mil - file and path helpers for minilang
//
// Thin wrappers around the built-in readFile / writeFile / fileExists, plus
// line-based and path-based helpers.
//
//   require io;
//   var lines = io.readLines("data.txt");
//   io.writeLines("out.txt", lines);
//   println io.basename("dir/a.txt");        // a.txt

// Read a whole file ("" when missing)
func read(path) {
    if (fileExists(path) == 0) { return ""; }
    return readFile(path);
}

// Write a whole file (returns 1 on success)
func write(path, content) {
    return writeFile(path, content);
}

// Append to a file, creating it when missing (returns 1 on success)
func append(path, content) {
    var old = "";
    if (fileExists(path) == 1) { old = readFile(path); }
    return writeFile(path, old + content);
}

func exists(path) {
    return fileExists(path);
}

// Read a file as an array of lines (no trailing newline characters)
func readLines(path) {
    var text = read(path);
    if (len(text) == 0) { return array(0, ""); }
    return iosplitLines(text);
}

// Write an array of lines, one per line (returns 1 on success)
func writeLines(path, lines) {
    var out = "";
    var i = 0;
    while (i < len(lines)) {
        out = out + lines[i] + "\n";
        i = i + 1;
    }
    return writeFile(path, out);
}

// Append a single line (returns 1 on success)
func appendLine(path, line) {
    return append(path, line + "\n");
}

// ===== Paths =====
// Join two path parts with "/" (adds a separator only when needed)
func pathJoin(a, b) {
    if (len(a) == 0) { return b; }
    if (len(b) == 0) { return a; }
    if (charAt(a, len(a) - 1) == 47) {
        if (charAt(b, 0) == 47) { return a + substr(b, 1, len(b) - 1); }
        return a + b;
    }
    if (charAt(b, 0) == 47) { return a + b; }
    return a + "/" + b;
}

// Everything after the last "/" (or the whole input)
func basename(path) {
    var i = len(path) - 1;
    while (i >= 0) {
        if (charAt(path, i) == 47) { return substr(path, i + 1, len(path) - i - 1); }
        i = i - 1;
    }
    return path;
}

// Everything before the last "/" ("." when there is none)
func dirname(path) {
    var i = len(path) - 1;
    while (i >= 0) {
        if (charAt(path, i) == 47) {
            if (i == 0) { return "/"; }
            return substr(path, 0, i);
        }
        i = i - 1;
    }
    return ".";
}

// Extension including the dot ("" when there is none)
func ext(path) {
    var name = basename(path);
    var i = len(name) - 1;
    while (i >= 0) {
        if (charAt(name, i) == 46) { return substr(name, i, len(name) - i); }
        i = i - 1;
    }
    return "";
}

// basename without its extension
func stem(path) {
    var name = basename(path);
    var e = ext(path);
    if (len(e) == 0) { return name; }
    return substr(name, 0, len(name) - len(e));
}

// Replace the extension (dot optional in the new extension)
func withExt(path, newExt) {
    var d = dirname(path);
    var s = stem(path);
    if (len(newExt) > 0) {
        if (charAt(newExt, 0) != 46) { newExt = "." + newExt; }
    }
    return pathJoin(d, s + newExt);
}

// ===== Internal =====
// Split text into lines, handling "\n" and "\r\n"
func iosplitLines(text) {
    var t = text;
    var out = array(0, "");
    var cur = "";
    var i = 0;
    var n = len(t);
    while (i < n) {
        var c = charAt(t, i);
        if (c == 10) {
            out = iopush(out, cur);
            cur = "";
            i = i + 1;
        } else {
            if (c == 13) {
                if (i + 1 < n) {
                    if (charAt(t, i + 1) == 10) { i = i + 1; }
                }
                out = iopush(out, cur);
                cur = "";
                i = i + 1;
            } else {
                cur = cur + chr(c);
                i = i + 1;
            }
        }
    }
    if (len(cur) > 0) { out = iopush(out, cur); }
    return out;
}

func iopush(a, x) {
    var n = len(a);
    var b = array(n + 1, x);
    var i = 0;
    while (i < n) {
        b[i] = a[i];
        i = i + 1;
    }
    return b;
}
