require string;
require list;
require sort;
require rand;
require io;

func dumpInts(a) {
    var out = "[";
    var i = 0;
    while (i < len(a)) {
        if (i > 0) { out = out + ", "; }
        out = out + toString(a[i]);
        i = i + 1;
    }
    println out + "]";
    return 0;
}

func dumpStrs(a) {
    var out = "[";
    var i = 0;
    while (i < len(a)) {
        if (i > 0) { out = out + ", "; }
        out = out + a[i];
        i = i + 1;
    }
    println out + "]";
    return 0;
}

func main() {
    // ===== string =====
    println "[" + string.trim("  hi  ") + "]";
    println "[" + string.trimLeft("  hi  ") + "]";
    println "[" + string.trimRight("  hi  ") + "]";
    dumpStrs(string.split("a,b,c", ","));
    dumpStrs(string.split("one", ","));
    println string.join(["x", "y", "z"], "-");
    println string.replace("a-b-c", "-", "+");
    println string.replace("aaa", "a", "ab");
    println string.toUpper("Hello 123");
    println string.toLower("Hello 123");
    println string.capitalize("hello world again");
    println toString(string.indexOf("banana", "na"));
    println toString(string.lastIndexOf("banana", "na"));
    println toString(string.indexOf("abc", "z"));
    println "[" + string.padLeft("7", 3, "0") + "]";
    println "[" + string.padRight("7", 3, "0") + "]";
    println toString(string.isInt("-123"));
    println toString(string.isInt("12a"));
    println toString(string.isUpper("ABC"));
    println toString(string.isLower("abc"));
    dumpStrs(string.words("  a  b\tc\n d "));
    dumpStrs(string.lines("l1\nl2\r\nl3"));
    println "[" + string.drop("hello", 2) + "]";
    println "[" + string.take("hello", 2) + "]";
    println toString(string.isEmpty(""));
    println toString(string.contains("haystack", "stack"));
    println string.reverse("abc");
    println string.repeat("ab", 3);
    println toString(string.countChar("aab", 97));

    // ===== list =====
    var a = list.range(0, 5);
    dumpInts(a);
    dumpInts(list.push(a, 99));
    dumpInts(list.pop(a));
    println toString(list.last(a));
    println toString(list.first(a));
    dumpInts(list.insert(a, 2, 42));
    dumpInts(list.remove(a, 1));
    dumpInts(list.slice(a, 1, 3));
    dumpInts(list.concat(a, [7, 8]));
    dumpInts(list.reverse(a));
    println toString(list.indexOf(a, 3));
    println toString(list.indexOf(a, 99));
    println toString(list.contains(a, 4));
    println toString(list.count([1, 2, 1, 1], 1));
    println toString(list.sum(a));
    println toString(list.min([3, 1, 2]));
    println toString(list.max([3, 1, 2]));
    println list.join(["a", "b"], "/");
    var sw = [1, 2];
    list.swap(sw, 0, 1);
    dumpInts(sw);
    println toString(list.equal([1, 2], [1, 2]));
    println toString(list.equal([1, 2], [1, 3]));

    // ===== sort =====
    var unsorted = [5, 3, 9, 1, 7, 3];
    sort.ints(unsorted);
    dumpInts(unsorted);
    println toString(sort.isSorted(unsorted));
    println toString(sort.bsearch(unsorted, 7));
    println toString(sort.bsearch(unsorted, 6));
    sort.intsDesc(unsorted);
    dumpInts(unsorted);
    var names = ["bob", "ann", "cid"];
    sort.strings(names);
    dumpStrs(names);
    println toString(sort.bsearchStr(names, "ann"));
    println toString(sort.bsearchStr(names, "zed"));
    var near = [1, 2, 4, 3];
    sort.insert(near);
    dumpInts(near);

    // ===== rand (deterministic) =====
    rand.seed(42);
    println toString(rand.int(100));
    println toString(rand.range(1, 7));
    println toString(rand.chance(50));
    var deck = list.range(1, 6);
    rand.shuffle(deck);
    dumpInts(deck);
    println toString(rand.pick(["a", "b", "c"]));

    // ===== io =====
    println io.pathJoin("dir", "a.txt");
    println io.pathJoin("dir/", "a.txt");
    println io.basename("dir/sub/a.txt");
    println io.dirname("dir/sub/a.txt");
    println io.dirname("a.txt");
    println io.ext("dir/a.txt");
    println io.stem("dir/a.txt");
    println io.withExt("dir/a.txt", "md");
    var tmp = "/tmp/minilang_io_test.txt";
    println toString(io.write(tmp, "one\ntwo\n"));
    var ls = io.readLines(tmp);
    dumpStrs(ls);
    println toString(len(ls));
    println toString(io.appendLine(tmp, "three"));
    dumpStrs(io.readLines(tmp));
    println toString(io.exists(tmp));
    println toString(io.exists("/tmp/definitely_missing_file_xyz"));
    println "[" + io.read("/tmp/definitely_missing_file_xyz") + "]";
    return 0;
}
